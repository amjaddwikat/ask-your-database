# Copy to .env (or .env.local) for `npm run dev`. Never commit the real file.
# Vite inlines VITE_* values into the JavaScript bundle, so everything here is visible to
# anyone who loads the page. Fine for a local demo; see the README for what production needs.

# Where the FastAPI backend listens (docker compose publishes it on 8000)
VITE_API_BASE_URL=http://localhost:8000
# Must match API_KEY in the repo-root .env
VITE_API_KEY=

# Optional: Supabase email sign-in. Leave both empty to run without a login screen.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
