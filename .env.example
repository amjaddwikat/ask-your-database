# Copy to .env and fill in. Never commit .env.

# Key clients send in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model the agents use (default gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Local MySQL passwords used by docker-compose
MYSQL_ROOT_PASSWORD=change-me-root
WAREHOUSE_DB_PASSWORD=change-me-readonly
APP_DB_PASSWORD=change-me-app
# Host port for MySQL (change if 3306 is already in use)
MYSQL_PORT=3306
