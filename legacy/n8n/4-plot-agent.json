    },
    {
      "parameters": {
        "jsCode": "\nconst sessionId = $input.first().json.sessionId;\nconst aiMsg = $input.first().json.output; // fixed variable name\n\nreturn [\n  {\n    json: {\n      role: \"Plot_Agent\",\n      content: aiMsg,\n      session_id: sessionId,\n    }\n  }\n];\n"
      },
