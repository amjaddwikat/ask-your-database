      ],
      "id": "c29b0698-6482-4f83-a574-6a591db7d58a",
      "name": "Sticky Note5"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "plotAgent",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -304,
        400
      ],
      "id": "f7161847-e5ad-4782-be8b-dd935aefd020",
      "name": "Plot Agent API"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  sub.id,\n  sub.session_id,\n  sub.role,\n  LEFT(sub.content, 1500) || CASE WHEN LENGTH(sub.content) > 1500 THEN '...' ELSE '' END AS content,\n  sub.created_at\nFROM (\n  SELECT *\n  FROM messages\n  WHERE session_id = '{{ $json.sessionId }}'\n  ORDER BY created_at DESC\n  LIMIT 10\n) sub\nWHERE sub.role IS DISTINCT FROM 'DB_Agent'\nORDER BY sub.created_at ASC;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        160,
        80
      ],
      "id": "9a686b50-31ea-4a45-82b2-d3bef830fd2a",
      "name": "conversation history",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const s = `You are a visualization assistant. For every user question, return exactly one and only one valid JSON object — no markdown fences, no comments, no JS, no trailing commas, no extra text. It must parse with JSON.parse(...) in one shot.\n\nSCHEMA:\n{\n  \"chart_config\": {\n    \"chartType\": \"bar|line|pie|scatter|...\",\n    \"x\": \"<existing field name>\",\n    \"y\": \"<existing field name>\",\n    \"groupBy\": \"<existing field name or null>\",\n    \"axes\": {\n      \"xLabel\": \"string\",\n      \"yLabel\": \"string\"\n    }\n  },\n  \"explanation\": \"{explain chart and give data insights on the chart}\"\n}\n\nINPUT: You will receive:\n- prompt (user question)\n- query (SQL used; context only)\n- tableText (newline-delimited JSON objects)\n\nTASK:\n1) Parse tableText into objects and detect available fields.\n2) Choose one sensible 2D chart from the fields present.\n3) Return only the single JSON object (matching schema) as the entire model output.\nUser conversation so far:\n${ $input.first().json.conversation_so_far }\n`;\nreturn [\n  {\n    json: {\n      prompt: s\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        80
      ],
      "id": "8417f2a0-0a9a-4612-8129-3a7c742284e7",
      "name": "Add it to prompt1"
    },
    {
      "parameters": {
        "jsCode": "// Handle empty or invalid input\nif (!items || !Array.isArray(items) || items.length === 0) {\n  return [{ json: { conversation_so_far: \"\" } }];\n}\n\n// Extract rows (supporting both raw and .json-wrapped items)\nconst rows = items.map(i => i.json ?? i).filter(r => r && r.role && r.content);\n\n// Sort by created_at if available\nrows.sort((a, b) => new Date(a.created_at || 0) - new Date(b.created_at || 0));\n\n// Build readable convo string (keep content raw)\nconst conversation = rows\n  .map(r => `${r.role.toUpperCase()}: ${r.content}`)\n  .join(\"\\n\\n\");\n\n// Return formatted result\nreturn [{ json: { conversation_so_far: conversation } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        80
      ],
      "id": "9b7ba8d9-17a7-4409-9bf2-43043c86ceb1",
      "name": "Edit format of history1"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5d96a051-d725-408d-a33b-381b535390a3",
              "name": "prompt",
              "value": "={{ $json.body.body.prompt }}",
              "type": "string"
            },
            {
              "id": "1cdde3a0-2823-4926-85e9-398803133cb9",
              "name": "sessionId",
              "value": "={{ $json.body.body.session_id }}",
              "type": "string"
            },
            {
              "id": "65d1bb1a-1301-4a8b-9fe2-ff3c4e446e80",
              "name": "explanation",
              "value": "={{ $json.body.body.explanation }}",
              "type": "string"
            },
            {
              "id": "c60b2654-fff3-4a88-b45a-7118f8fda80e",
              "name": "query",
              "value": "={{ $json.body.query }}",
              "type": "string"
            },
            {
              "id": "3cc124d8-b1d3-4b6b-a8c6-0b6e0e711bcf",
              "name": "tableText",
              "value": "={{ $json.body.body.tableText }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -80,
        384
      ],
      "id": "5b3059ad-f7bf-4874-b645-1f59339f7433",
      "name": "Extract input fields1"
    },
    {
      "parameters": {
        "jsCode": "// n8n Function Node\n\n// Get input data\nconst items = $input.all();\n\n// Transform each item\nreturn items.map(item => {\n  const data = item.json;\n\n  // Build the text\n  const combined = `User input: \"${data.prompt}\". Query generated to answer user: \"${data.query}\". Data generated from query: ${data.tableText}`;\n\n  return {\n    json: {\n      input: combined,\n      sessionId: data.sessionId || \"unknown-session\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        288
      ],
      "id": "c09eb0b8-7252-4caf-b9a1-7c6f75b75794",
      "name": "edit json format"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        704,
        160
      ],
      "id": "c3dc8d48-6954-4a2b-b978-dd7386f4b5ae",
      "name": "Combine1"
    },
    {
      "parameters": {
        "jsCode": "// n8n Function node\nconst item = $input.first().json;\n\n// Gemini expects \"contents\" not \"messages\"\nconst body = {\n  contents: [\n    {\n      role: \"user\",\n      parts: [\n        {\n          text: `${item.prompt}\\n\\n${item.input}`\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    temperature: 0,\n    topK: 40,\n    topP: 0.95,\n    maxOutputTokens: 1024\n  }\n};\n\nreturn [{ json: body }];\nreturn [\n  {\n    out: body\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "id": "f78c5a10-2641-4eea-9a72-dfe63a714bc2",
      "name": "OpenAI message format1"
    },
