    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json.output ?? null;\n\nif (!raw || raw.trim() === \"\") {\n  return [{ json: { query: \"\", explanation: \"no explanation available\" } }];\n}\n\n// Strip markdown code fences if present\nconst cleaned = raw\n  .trim()\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  return [{ json: { query: \"failed to parse JSON\", explanation: `JSON parse error: ${err.message}` } }];\n}\n\nconst query = parsed.query?.trim() ?? \"\";\nconst explanation = parsed.explanation?.trim() ?? \"no explanation provided\";\nconst total_tokens = $input.first().json.total_tokens || 0;\nconst cleanedQuery = query.endsWith(';') ? query.slice(0, -1) : query;\n\nreturn [\n  {\n    json: {\n      query: cleanedQuery,\n      explanation,\n      total_tokens\n    },\n  },\n];"
      },
