    {
      "parameters": {
        "jsCode": "// Function node — merges input fields into one message content\nconst raw = $input.first().json;\n\n// Handle array or single object\nconst dataArray = Array.isArray(raw) ? raw : [raw];\n\nconst content = dataArray\n  .map(obj =>\n    Object.entries(obj)\n      .filter(([key]) => key !== \"total_tokens\") // 🚫 skip total_tokens\n      .map(([key, val]) => `${key}: ${typeof val === \"object\" ? JSON.stringify(val) : val}`)\n      .join(\"\\n\")\n  )\n  .join(\"\\n\\n---\\n\\n\");\n\n\n// Build final payload with fixed role\nconst payload = {\n  role: \"DB_Agent\",\n  content\n};\n\n// Return as json\nreturn [{ json: payload }];\n"
      },
      "type": "n8n-nodes-base.code",
