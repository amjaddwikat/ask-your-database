    {
      "parameters": {
        "jsCode": "// Handle empty or invalid input\nif (!items || !Array.isArray(items) || items.length === 0) {\n  return [{ json: { conversation_so_far: \"\" } }];\n}\n\n// Extract rows (supporting both raw and .json-wrapped items)\nconst rows = items.map(i => i.json ?? i).filter(r => r && r.role && r.content);\n\n// Sort by created_at if available\nrows.sort((a, b) => new Date(a.created_at || 0) - new Date(b.created_at || 0));\n\n// Build readable convo string (keep content raw)\nconst conversation = rows\n  .map(r => `${r.role.toUpperCase()}: ${r.content}`)\n  .join(\"\\n\\n\");\n\n// Return formatted result\nreturn [{ json: { conversation_so_far: conversation } }];\n"
      },
