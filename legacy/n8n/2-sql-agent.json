    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  session_id,\n  role,\n  LEFT(content, 1500) || CASE WHEN LENGTH(content) > 1500 THEN '...' ELSE '' END AS content,\n  created_at\nFROM messages\nWHERE session_id = '{{ $json.body.session_id }}'\nORDER BY id ASC\nLIMIT 10;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
