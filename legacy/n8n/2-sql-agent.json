        "jsCode": "return items.map(item => {\n  const errObj = item.json.error || null;\n  const query = item.json.query ?? null;\n  const explanation = item.json.explanation ?? null;\n  const total_tokens = item.json.total_tokens ?? 0;\n\n  // grab only the message string if exists\n  const error = errObj?.message ?? null;\n\n  return {\n    json: {\n      error,\n      query,\n      explanation,\n      total_tokens\n    }\n  };\n});\n"
