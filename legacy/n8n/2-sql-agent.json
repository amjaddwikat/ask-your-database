    {
      "parameters": {
        "jsCode": "// n8n Function Node\n// Merge fields from incoming item into one expressive `input` string.\n// Outputs: [{ json: { input: \"...\", original: { ... } } }, ...]\n\n// safe getter\nfunction g(obj, keys) {\n  for (const k of keys) {\n    if (obj && Object.prototype.hasOwnProperty.call(obj, k) && obj[k] !== undefined && obj[k] !== null) {\n      return obj[k];\n    }\n  }\n  return \"\";\n}\n\nconst items = $input.all();\n\nreturn items.map(item => {\n  const d = item.json || {};\n\n  const convo = g(d, [\"conversation_so_far\", \"conversationSoFar\", \"conversation\"]);\n  const userNext = g(d, [\"output\", \"user_output\", \"user_input\"]);\n  const rephrased = g(d, [\"rephrased_question\", \"rephrasedQuestion\", \"rephrased\"]);\n  const rulesArr = d.relevant_rules || d.relevantRules || d.rules || [];\n\n  // ensure rules is a string (join array if needed)\n  const rules = Array.isArray(rulesArr) ? rulesArr.join(\"\\n- \") : (rulesArr || \"\");\n\n  const parts = [];\n\n  parts.push(`User's question (raw): ${userNext || \"(none)\"}\\n`);\n  parts.push(`User's question (rephrased): ${rephrased || \"(none)\"}\\n`);\n\n  if (rules) {\n    parts.push(`Relevant rules / guidance:\\n- ${rules}`);\n  } else {\n    parts.push(\"Relevant rules / guidance: (none)\");\n  }\n  parts.push(`Conversation so far:\\n${convo || \"(no prior conversation)\"}\\n`);\n\n  parts.push(\"\\nAuto-note: Use the conversation context above plus the rules to answer the rephrased question precisely. Prioritize filing status logic when evaluating unresolved conflicts.\");\n\n  const combined = parts.join(\"\\n\");\n\n  return {\n    json: {\n      input: combined\n    }\n  };\n});\n"
      },
