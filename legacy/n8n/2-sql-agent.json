      "parameters": {
        "jsCode": "// Function node — insert-ready record with query \"\" and explanation inside content\nconst raw = $input.first().json;\nconst dataArray = Array.isArray(raw) ? raw : [raw];\n\n// Grab first explanation or empty\nconst explanation =\n  dataArray.map(o => o.explanation).find(v => v && v.trim()) || \"\";\n\n// Set role (default DB_Agent)\nconst role = $env.DEFAULT_ROLE || \"DB_Agent_Exp\";\n\n// Build content string with empty query and explanation\nconst content = `query: \"\"\\nexplanation: ${explanation}`;\n\n// Build final payload\nreturn [{\n  json: {\n    role,\n    content\n  }\n}];\n"
