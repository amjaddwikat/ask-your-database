      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst dataArray = Array.isArray(raw) ? raw : [raw];\n\n// Grab fields safely\nconst first = dataArray[0] || {};\nconst query = first.query || \"\";\nconst error = first.error || \"\";\nconst explanation = first.explanation || \"\";\n\n// Set role (default DB_Agent)\nconst role = $env.DEFAULT_ROLE || \"DB_Agent\";\n\n// Merge all into one content block\nconst content = `query: \"${query}\"\\nerror: ${error}\\nexplanation: ${explanation}`;\n\n// Build final payload\nconst payload = {\n  role,\n  content\n};\n\n// Return top-level json so DB node can insert directly\nreturn [{ json: payload }];\n"
