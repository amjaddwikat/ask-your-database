    {
      "parameters": {
        "jsCode": "// Flatten all rows, focusing only on meaningful data inside body/results\nconst allRows = items.flatMap(item => {\n  const data = item.json;\n\n  // if body.results exists and is an array, extract those rows\n  if (data.body && Array.isArray(data.body.results)) {\n    return data.body.results.map(obj => JSON.stringify(obj));\n  }\n\n  // if body itself is an array, flatten it\n  if (Array.isArray(data.body)) {\n    return data.body.map(obj => JSON.stringify(obj));\n  }\n\n  // if body is an object with useful fields (not nested results)\n  if (data.body && typeof data.body === 'object') {\n    return [JSON.stringify(data.body)];\n  }\n\n  // fallback: stringify the whole thing\n  return [JSON.stringify(data)];\n});\n\nconst rows = allRows.join('\\n');\n\nreturn [{ json: { tableText: rows } }];\n"
      },
